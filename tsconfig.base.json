{
  "compilerOptions": {
    "baseUrl": ".",
    "composite": false,
    "emitDeclarationOnly": false,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022", "dom"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "paths": {
      "@data-access/apis/billing-api": [
        "./libs/data-access/apis/billing-api/src/index.ts"
      ],
      "@shared/features/auth": ["./libs/shared/features/auth/src/index.ts"],
      "@billing/shell": ["./libs/billing/shell/src/index.ts"],
      "@shared/layouts": ["./libs/shared/layouts/src/index.ts"],
      "@states/works-query": [
        "./libs/data-access/states/works-query/src/index.ts"
      ],
      "@states/authentication": [
        "./libs/data-access/states/authentication/src/index.ts"
      ]
    }
  }
}
